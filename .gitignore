# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.env/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Broken / leftover virtualenvs
.venv.*/
**/.venv.*/
backend/.venv.broken_*/

# Runtime data (Chroma index, SQLite, generated admin CSVs — reseeded on boot)
backend/data/chroma/
backend/data/*.db
backend/data/sheets/*.csv
backend/data/sheets/.seed_version
# Keep sheet README; curated facts live in backend/facts/ (outside the SAE data volume)
!backend/data/sheets/README.txt
*.db

# Node
frontend/node_modules/
frontend/dist/
frontend/.env
frontend/.env.local
frontend/.env.*.local
frontend/ossutil_output/

# OS / IDE
.DS_Store
Thumbs.db
.idea/
.vscode/
*.code-workspace
*.swp
*~

# Secrets — never commit real keys (keep *.example tracked)
.env
**/.env
!**/.env.example
!**/.env*.example

# Local deploy / cloud CLI leftovers
*.pem
*.key
credentials.json
.aliyun/
ossutil_output/
**/ossutil_output/
