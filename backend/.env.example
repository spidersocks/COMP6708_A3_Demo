# DashScope native API (Model Studio) — NOT OpenAI compatible-mode
# Copy to backend/.env and fill in your own key (never commit .env)
DASHSCOPE_API_KEY=sk-your-dashscope-api-key
DASHSCOPE_BASE_URL=https://cn-hongkong.dashscope.aliyuncs.com/api/v1
LLM_MODEL=qwen3.8-flash
EMBEDDING_MODEL=text-embedding-v4

# RAG
RAG_TOP_K=5
CONTENT_DIR=../content
CHROMA_DIR=./data/chroma

# CORS (comma-separated; use * for local demo)
CORS_ORIGINS=*

# Multi-turn memory (~5 turns = 10 messages)
CHAT_HISTORY_ENABLED=true
CHAT_HISTORY_LIMIT=10
# CHAT_HISTORY_DB=./data/chat_history.db

# Opening hours + HKO severe weather + HK public holidays
OPENING_HOURS_ENABLED=true
OPENING_HOURS_WEATHER_ENABLED=true

# Optional overrides
# GEN_MAX_TOKENS=500
# GEN_TEMPERATURE=0.3
